{"id":"CVE-2007-4654","state":"PUBLISHED","assigner":"mitre","published":"2007-09-04T22:00:00.000Z","updated":"2024-08-07T15:01:10.132Z","description":"Unspecified vulnerability in SSHield 1.6.1 with OpenSSH 3.0.2p1 on Cisco WebNS 8.20.0.1 on Cisco Content Services Switch (CSS) series 11000 devices allows remote attackers to cause a denial of service (connection slot exhaustion and device crash) via a series of large packets designed to exploit the SSH CRC32 attack detection overflow (CVE-2001-0144), possibly a related issue to CVE-2002-1024.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://osvdb.org/45873","tags":["vdb-entry","x_refsource_OSVDB"],"name":"45873"},{"url":"http://securityreason.com/securityalert/3091","tags":["third-party-advisory","x_refsource_SREASON"],"name":"3091"},{"url":"https://exchange.xforce.ibmcloud.com/vulnerabilities/44542","tags":["vdb-entry","x_refsource_XF"],"name":"cisco-css-sshield-dos(44542)"},{"url":"http://www.securityfocus.com/archive/1/478165/100/0/threaded","tags":["mailing-list","x_refsource_BUGTRAQ"],"name":"20070830 Cisco CSS WebNS ssh crash"}],"vendors":["cisco","openssh"]}
