.org/fulldisclosure/2015/Jul/92","tags":["mailing-list"],"name":"20150717 OpenSSH keyboard-interactive authentication brute force vulnerability (MaxAuthTries bypass)"},{"url":"http://www.oracle.com/technetwork/topics/security/bulletinoct2015-2511968.html"},{"url":"https://www.arista.com/en/support/advisories-notices/security-advisories/1174-security-advisory-12"},{"url":"https://cert-portal.siemens.com/productcert/pdf/ssa-412672.pdf"}],"vendors":["openssh"]}
{"id":"CVE-2015-6563","state":"PUBLISHED","assigner":"mitre","published":"2015-08-24T00:00:00.000Z","updated":"2026-05-27T16:11:52.468Z","description":"The monitor component in sshd in OpenSSH before 7.0 on non-OpenBSD platforms accepts extraneous username data in MONITOR_REQ_PAM_INIT_CTX requests, which allows local users to conduct impersonation attacks by leveraging any SSH login access in conjunction with control of the sshd uid to send a crafted MONITOR_REQ_PWNAM request, related to monitor.c and monitor_wrap.c.","cwe":["n/a","CWE-20 CWE-20 Improper Input Validation"],"metrics":[{"src":"CISA-ADP","v":"3.1","score":6.4,"sev":"MEDIUM","vector":"CVSS:3.1/AV:L/AC:H/PR:H/UI:N/S:U/C:H/I:H/A:H"},{"src":"CISA-ADP","ssvc":{"Exploitation":"none","Automatable":"no","Technical Impact":"total"}}],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://www.openwall.com/lists/oss-security/2015/08/22/1","tags":["mailing-list"],"name":"[oss-security] 20150821 Re: CVE request - OpenSSH 6.9 PAM privilege separation vulnerabilities"},{"url":"http://lists.fedoraproject.org/pipermail/package-announce/2015-August/165170.html","tags":["vendor-advisory"],"name":"FEDORA-2015-13469"},{"url":"http://lists.apple.com/archives/security-announce/2015/Oct/msg00005.html","tags":["vendor-advisory"],"name":"APPLE-SA-2015-10-21-4"},{"url":"https://support.apple.com/HT205375"},{"url":"http://www.securityfocus.com/bid/76317","tags":["vdb-entry"],"name":"76317"},{"url":"https://github.com/openssh/openssh-portable/commit/d4697fe9a28dab7255c60433e4dd23cf7fce8a8b"},{"url":"http://www.oracle.com/technetwork/topics/security/linuxbulletinapr2016-2952096.html"},{"url":"https://security.gentoo.org/glsa/201512-04","tags":["vendor-advisory"],"name":"GLSA-201512-04"},{"url":"http://www.openssh.com/txt/release-7.0"},{"url":"http://www.oracle.com/technetwork/topics/security/linuxbulletinoct2015-2719645.html"},{"url":"http://rhn.redhat.com/errata/RHSA-2016-0741.html",