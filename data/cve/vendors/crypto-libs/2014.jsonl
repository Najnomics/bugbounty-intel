{"id":"CVE-2014-1959","state":"PUBLISHED","assigner":"mitre","published":"2014-03-06T18:00:00.000Z","updated":"2024-08-06T09:58:15.628Z","description":"lib/x509/verify.c in GnuTLS before 3.1.21 and 3.2.x before 3.2.11 treats version 1 X.509 certificates as intermediate CAs, which allows remote attackers to bypass intended restrictions by leveraging a X.509 V1 certificate from a trusted CA to issue new certificates.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://www.gnutls.org/security.html","tags":["x_refsource_CONFIRM"]},{"url":"http://seclists.org/oss-sec/2014/q1/344","tags":["mailing-list","x_refsource_MLIST"],"name":"[oss-security] 20140213 CVE Request - GnuTLS corrects flaw in certificate verification (3.1.x/3.2.x)"},{"url":"http://seclists.org/oss-sec/2014/q1/345","tags":["mailing-list","x_refsource_MLIST"],"name":"[oss-security] 20140213 Re: CVE Request - GnuTLS corrects flaw in certificate verification (3.1.x/3.2.x)"},{"url":"http://www.securityfocus.com/bid/65559","tags":["vdb-entry","x_refsource_BID"],"name":"65559"},{"url":"http://www.ubuntu.com/usn/USN-2121-1","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-2121-1"},{"url":"https://www.gitorious.org/gnutls/gnutls/commit/b1abfe3d182d68539900092eb42fc62cf1bb7e7c","tags":["x_refsource_CONFIRM"]},{"url":"http://www.debian.org/security/2014/dsa-2866","tags":["vendor-advisory","x_refsource_DEBIAN"],"name":"DSA-2866"}],"vendors":["crypto-libs"]}
