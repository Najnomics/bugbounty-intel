{"id":"CVE-2018-10846","state":"PUBLISHED","assigner":"redhat","published":"2018-08-22T13:00:00.000Z","updated":"2024-08-05T07:46:47.512Z","description":"A cache-based side channel in GnuTLS implementation that leads to plain text recovery in cross-VM attack setting was found. An attacker could use a combination of \"Just in Time\" Prime+probe attack in combination with Lucky-13 attack to recover plain text using crafted packets.","cwe":["CWE-385 CWE-385"],"metrics":[{"src":"cna","v":"3.0","score":5.3,"sev":"MEDIUM","vector":"CVSS:3.0/AV:L/AC:H/PR:L/UI:R/S:C/C:H/I:N/A:N"}],"affected":[{"vendor":"[UNKNOWN]","product":"gnutls","versions":["affected n/a"]}],"references":[{"url":"https://eprint.iacr.org/2018/747","tags":["x_refsource_MISC"]},{"url":"https://gitlab.com/gnutls/gnutls/merge_requests/657","tags":["x_refsource_CONFIRM"]},{"url":"https://access.redhat.com/errata/RHSA-2018:3505","tags":["vendor-advisory","x_refsource_REDHAT"],"name":"RHSA-2018:3505"},{"url":"http://www.securityfocus.com/bid/105138","tags":["vdb-entry","x_refsource_BID"],"name":"105138"},{"url":"https://bugzilla.redhat.com/show_bug.cgi?id=CVE-2018-10846","tags":["x_refsource_CONFIRM"]},{"url":"https://access.redhat.com/errata/RHSA-2018:3050","tags":["vendor-advisory","x_refsource_REDHAT"],"name":"RHSA-2018:3050"},{"url":"https://lists.debian.org/debian-lts-announce/2018/10/msg00022.html","tags":["mailing-list","x_refsource_MLIST"],"name":"[debian-lts-announce] 20181030 [SECURITY] [DLA 1560-1] gnutls28 security update"},{"url":"https://usn.ubuntu.com/3999-1/","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-3999-1"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/WDYY3R4F5CUTFAMXH2C5NKYFVDEJLTT7/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2020-f90fb78f70"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/ILMOWPKMTZAIMK5F32TUMO34XCABUCFJ/","tags":["vendo