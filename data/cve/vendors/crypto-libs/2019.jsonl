{"id":"CVE-2019-3829","state":"PUBLISHED","assigner":"redhat","published":"2019-03-27T17:24:17.000Z","updated":"2024-08-04T19:19:18.605Z","description":"A vulnerability was found in gnutls versions from 3.5.8 before 3.6.7. A memory corruption (double free) vulnerability in the certificate verification API. Any client or server application that verifies X.509 certificates with GnuTLS 3.5.8 or later is affected.","cwe":["CWE-416 CWE-416"],"metrics":[{"src":"cna","v":"3.0","score":5.3,"sev":"MEDIUM","vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L"}],"affected":[{"vendor":"gnutls","product":"gnutls","versions":["affected fixed in 3.6.7","affected affected from 3.5.8"]}],"references":[{"url":"https://www.gnutls.org/security-new.html#GNUTLS-SA-2019-03-27","tags":["x_refsource_MISC"]},{"url":"https://bugzilla.redhat.com/show_bug.cgi?id=CVE-2019-3829","tags":["x_refsource_CONFIRM"]},{"url":"https://gitlab.com/gnutls/gnutls/issues/694","tags":["x_refsource_CONFIRM"]},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/WRSOL66LHP4SD3Y2ECJDOGT4K663ECDU/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2019-971ded6f90"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/L7TJIBRJWGWSH6XIO2MXIQ3W6ES4R6I4/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2019-e8c1cf958f"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/A3ETBUFBB4G7AITAOUYPGXVMBGVXKUAN/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2019-46df367eed"},{"url":"https://security.gentoo.org/glsa/201904-14","tags":["vendor-advisory","x_refsource_GENTOO"],"name":"GLSA-201904-14"},{"url":"http://lists.opensuse.org/opensuse-security-announce/2019-05/msg00017.html","tags":["vendor-advisory","x_refsource_SUSE"],"name":"openSUSE-SU-2019:1353"},{"url":"https://usn.ubuntu.com/3999-1/","tags":["vendor-advisory","x_r