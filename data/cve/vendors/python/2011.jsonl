{"id":"CVE-2011-4940","state":"PUBLISHED","assigner":"redhat","published":"2012-06-27T10:00:00.000Z","updated":"2024-08-07T00:23:39.213Z","description":"The list_directory function in Lib/SimpleHTTPServer.py in SimpleHTTPServer in Python before 2.5.6c1, 2.6.x before 2.6.7 rc2, and 2.7.x before 2.7.2 does not place a charset parameter in the Content-Type HTTP header, which makes it easier for remote attackers to conduct cross-site scripting (XSS) attacks against Internet Explorer 7 via UTF-7 encoding.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://www.ubuntu.com/usn/USN-1592-1","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-1592-1"},{"url":"http://jvn.jp/en/jp/JVN51176027/index.html","tags":["third-party-advisory","x_refsource_JVN"],"name":"JVN#51176027"},{"url":"http://secunia.com/advisories/51040","tags":["third-party-advisory","x_refsource_SECUNIA"],"name":"51040"},{"url":"http://secunia.com/advisories/50858","tags":["third-party-advisory","x_refsource_SECUNIA"],"name":"50858"},{"url":"http://bugs.python.org/issue11442","tags":["x_refsource_CONFIRM"]},{"url":"http://www.securityfocus.com/bid/54083","tags":["vdb-entry","x_refsource_BID"],"name":"54083"},{"url":"http://www.ubuntu.com/usn/USN-1596-1","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-1596-1"},{"url":"http://www.ubuntu.com/usn/USN-1613-2","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-1613-2"},{"url":"http://jvndb.jvn.jp/jvndb/JVNDB-2012-000063","tags":["third-party-advisory","x_refsource_JVNDB"],"name":"JVNDB-2012-000063"},{"url":"https://bugzilla.redhat.com/show_bug.cgi?id=803500","tags":["x_refsource_CONFIRM"]},{"url":"http://secunia.com/advisories/51024","tags":["third-party-advisory","x_refsource_SECUNIA"],"name":"51024"},{"url":"http://www.ubuntu.com/usn/USN-1613-1","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-1613-1"}],"vendors":["microsoft","python"]}
