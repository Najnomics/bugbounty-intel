{"id":"CVE-2020-24583","state":"PUBLISHED","assigner":"mitre","published":"2020-09-01T12:33:13.000Z","updated":"2024-08-04T15:19:08.390Z","description":"An issue was discovered in Django 2.2 before 2.2.16, 3.0 before 3.0.10, and 3.1 before 3.1.1 (when Python 3.7+ is used). FILE_UPLOAD_DIRECTORY_PERMISSIONS mode was not applied to intermediate-level directories created in the process of uploading files. It was also not applied to intermediate-level collected static directories when using the collectstatic management command.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"https://docs.djangoproject.com/en/dev/releases/security/","tags":["x_refsource_MISC"]},{"url":"https://usn.ubuntu.com/4479-1/","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-4479-1"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/F2ZHO3GZCJMP3DDTXCNVFV6ED3W64NAU/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2020-94407454d7"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/ZCRPQCBTV3RZHKVZ6K6QOAANPRZQD3GI/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2020-6941c0a65b"},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/OLGFFLMF3X6USMJD7V5F5P4K2WVUTO3T/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2020-9c6b391162"},{"url":"https://www.oracle.com/security-alerts/cpujan2021.html","tags":["x_refsource_MISC"]},{"url":"https://groups.google.com/forum/#%21topic/django-announce/zFCMdgUnutU","tags":["x_refsource_MISC"]},{"url":"https://groups.google.com/forum/#%21topic/django-announce/Gdqn58RqIDM","tags":["x_refsource_MISC"]},{"url":"https://www.openwall.com/lists/oss-security/2020/09/01/2","tags":["x_refsource_MISC"]},{"url":"https://www.djangoproject.com/weblog/2020/sep/01/security-releases/","tags"