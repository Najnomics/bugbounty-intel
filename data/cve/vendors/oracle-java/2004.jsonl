{"id":"CVE-2004-1707","state":"PUBLISHED","assigner":"mitre","published":"2005-02-26T05:00:00.000Z","updated":"2024-08-08T01:00:37.205Z","description":"The (1) dbsnmp and (2) nmo programs in Oracle 8i, Oracle 9i, and Oracle IAS 9.0.2.0.1, on Unix systems, use a default path to find and execute library files while operating at raised privileges, which allows certain Oracle user accounts to gain root privileges via a modified libclntsh.so.9.0.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://secunia.com/advisories/12205","tags":["third-party-advisory","x_refsource_SECUNIA"],"name":"12205"},{"url":"https://exchange.xforce.ibmcloud.com/vulnerabilities/16839","tags":["vdb-entry","x_refsource_XF"],"name":"oracle-libraries-gain-privileges(16839)"},{"url":"http://marc.info/?l=bugtraq&m=109147677214087&w=2","tags":["mailing-list","x_refsource_BUGTRAQ"],"name":"20040802 OPEN3S - Local Privilege Elevation through Oracle products (Unix Platform)"},{"url":"http://www.securityfocus.com/bid/10829","tags":["vdb-entry","x_refsource_BID"],"name":"10829"}],"exploitdb":[{"edb":"24335","title":"Oracle9i Database - Default Library Directory Privilege Escalation","type":"local","platform":"unix","date":"2004-07-30","verified":"1"}],"vendors":["oracle-java"]}
