{"id":"CVE-2022-32214","state":"PUBLISHED","assigner":"hackerone","published":"2022-07-14T00:00:00.000Z","updated":"2025-04-30T22:24:43.342Z","description":"The llhttp parser <v14.20.1, <v16.17.1 and <v18.9.1 in the http module in Node.js does not strictly use the CRLF sequence to delimit HTTP requests. This can lead to HTTP Request Smuggling (HRS).","cwe":["CWE-444 HTTP Request Smuggling (CWE-444)"],"metrics":[],"affected":[{"vendor":"NodeJS","product":"Node","defaultStatus":"unaffected","versions":["affected 4.0 <4.* (semver)","affected 5.0 <5.* (semver)","affected 6.0 <6.* (semver)","affected 7.0 <7.* (semver)","affected 8.0 <8.* (semver)","affected 9.0 <9.* (semver)","affected 10.0 <10.* (semver)","affected 11.0 <11.* (semver)","affected 12.0 <12.* (semver)","affected 13.0 <13.* (semver)","affected 14.0 <14.20.0 (semver)","affected 15.0 <15.* (semver)","affected 16.0 <16.20.0 (semver)","affected 17.0 <17.* (semver)","affected 18.0 <18.5.0 (semver)"]}],"references":[{"url":"https://nodejs.org/en/blog/vulnerability/july-2022-security-releases/"},{"url":"https://hackerone.com/reports/1524692"},{"url":"https://www.debian.org/security/2023/dsa-5326","tags":["vendor-advisory"],"name":"DSA-5326"}],"vendors":["nodejs"]}
