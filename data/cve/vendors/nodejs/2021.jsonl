{"id":"CVE-2021-22960","state":"PUBLISHED","assigner":"hackerone","published":"2021-11-03T19:22:42.000Z","updated":"2025-04-30T22:24:38.152Z","description":"The parse function in llhttp < 2.1.4 and < 6.0.6. ignores chunk extensions when parsing the body of chunked requests. This leads to HTTP Request Smuggling (HRS) under certain conditions.","cwe":["CWE-444 HTTP Request Smuggling (CWE-444)"],"metrics":[],"affected":[{"vendor":"NodeJS","product":"Node","defaultStatus":"unaffected","versions":["affected 4.0 <4.* (semver)","affected 5.0 <5.* (semver)","affected 6.0 <6.* (semver)","affected 7.0 <7.* (semver)","affected 8.0 <8.* (semver)","affected 9.0 <9.* (semver)","affected 10.0 <10.* (semver)","affected 11.0 <11.* (semver)","affected 12.0 <12.22.7 (semver)","affected 13.0 <13.* (semver)","affected 14.0 <14.18.1 (semver)","affected 15.0 <15.* (semver)","affected 16.0 <16.11.1 (semver)"]}],"references":[{"url":"https://hackerone.com/reports/1238099","tags":["x_refsource_MISC"]},{"url":"https://www.oracle.com/security-alerts/cpujan2022.html","tags":["x_refsource_MISC"]},{"url":"https://www.debian.org/security/2022/dsa-5170","tags":["vendor-advisory","x_refsource_DEBIAN"],"name":"DSA-5170"}],"vendors":["nodejs"]}
