{"id":"CVE-2020-8201","state":"PUBLISHED","assigner":"hackerone","published":"2020-09-18T20:12:43.000Z","updated":"2025-04-30T22:24:25.163Z","description":"Node.js < 12.18.4 and < 14.11 can be exploited to perform HTTP desync attacks and deliver malicious payloads to unsuspecting users. The payloads can be crafted by an attacker to hijack user sessions, poison cookies, perform clickjacking, and a multitude of other attacks depending on the architecture of the underlying system. The attack was possible due to a bug in processing of carrier-return symbols in the HTTP header names.","cwe":["CWE-444 HTTP Request Smuggling (CWE-444)"],"metrics":[],"affected":[{"vendor":"NodeJS","product":"Node","defaultStatus":"unaffected","versions":["affected 4.0 <4.* (semver)","affected 5.0 <5.* (semver)","affected 6.0 <6.* (semver)","affected 7.0 <7.* (semver)","affected 8.0 <8.* (semver)","affected 9.0 <9.* (semver)","affected 11.0 <11.* (semver)","affected 12.0 <12.18.4 (semver)","affected 13.0 <13.* (semver)","affected 14.0 <14.11.0 (semver)"]}],"references":[{"url":"https://nodejs.org/en/blog/vulnerability/september-2020-security-releases/","tags":["x_refsource_MISC"]},{"url":"https://hackerone.com/reports/922597","tags":["x_refsource_MISC"]},{"url":"http://lists.opensuse.org/opensuse-security-announce/2020-10/msg00011.html","tags":["vendor-advisory","x_refsource_SUSE"],"name":"openSUSE-SU-2020:1616"},{"url":"https://security.netapp.com/advisory/ntap-20201009-0004/","tags":["x_refsource_CONFIRM"]},{"url":"https://lists.fedoraproject.org/archives/list/package-announce%40lists.fedoraproject.org/message/4OOYAMJVLLCLXDTHW3V5UXNULZBBK4O6/","tags":["vendor-advisory","x_refsource_FEDORA"],"name":"FEDORA-2020-43d5a372fc"},{"url":"https://security.gentoo.org/glsa/202101-07","tags":["vendor-advisory","x_refsource_GENTOO"],"name":"GLSA-202101-07"}],"vendors":["nodejs"]}
