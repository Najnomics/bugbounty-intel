{"id":"CVE-2018-16844","state":"PUBLISHED","assigner":"redhat","published":"2018-11-07T14:00:00.000Z","updated":"2024-08-05T10:32:54.086Z","description":"nginx before versions 1.15.6 and 1.14.1 has a vulnerability in the implementation of HTTP/2 that can allow for excessive CPU usage. This issue affects nginx compiled with the ngx_http_v2_module (not compiled by default) if the 'http2' option of the 'listen' directive is used in a configuration file.","cwe":["CWE-400 CWE-400"],"metrics":[{"src":"cna","v":"3.0","score":5.3,"sev":"MEDIUM","vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L"}],"affected":[{"vendor":"[UNKNOWN]","product":"nginx","versions":["affected 1.15.6","affected 1.14.1"]}],"references":[{"url":"https://www.debian.org/security/2018/dsa-4335","tags":["vendor-advisory","x_refsource_DEBIAN"],"name":"DSA-4335"},{"url":"https://bugzilla.redhat.com/show_bug.cgi?id=CVE-2018-16844","tags":["x_refsource_CONFIRM"]},{"url":"https://access.redhat.com/errata/RHSA-2018:3680","tags":["vendor-advisory","x_refsource_REDHAT"],"name":"RHSA-2018:3680"},{"url":"https://access.redhat.com/errata/RHSA-2018:3681","tags":["vendor-advisory","x_refsource_REDHAT"],"name":"RHSA-2018:3681"},{"url":"http://www.securityfocus.com/bid/105868","tags":["vdb-entry","x_refsource_BID"],"name":"105868"},{"url":"http://mailman.nginx.org/pipermail/nginx-announce/2018/000220.html","tags":["x_refsource_MISC"]},{"url":"http://www.securitytracker.com/id/1042038","tags":["vdb-entry","x_refsource_SECTRACK"],"name":"1042038"},{"url":"https://usn.ubuntu.com/3812-1/","tags":["vendor-advisory","x_refsource_UBUNTU"],"name":"USN-3812-1"},{"url":"http://lists.opensuse.org/opensuse-security-announce/2019-09/msg00035.html","tags":["vendor-advisory","x_refsource_SUSE"],"name":"openSUSE-SU-2019:2120"},{"url":"https://support.apple.com/kb/HT212818","tags":["x_refsource_CONFIRM"]},{"url":"http://seclists.org/fulldisclosure/2021/Sep/36","tags":["mailing-list","x_refsource_FULLDISC"],"name":"20210921 APPLE-S