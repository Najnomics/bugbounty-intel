{"id":"CVE-2024-39792","state":"PUBLISHED","assigner":"f5","published":"2024-08-14T14:32:33.519Z","updated":"2024-08-15T14:01:37.776Z","title":"NGINX Plus MQTT vulnerability","description":"When the NGINX Plus is configured to use the MQTT pre-read module, undisclosed requests can cause an increase in memory resource utilization.  Note: Software versions which have reached End of Technical Support (EoTS) are not evaluated.","cwe":["CWE-825 CWE-825 Expired Pointer Dereference"],"metrics":[{"src":"cna","v":"3.1","score":7.5,"sev":"HIGH","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H"},{"src":"cna","v":"4.0","score":8.7,"sev":"HIGH","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N"},{"src":"CISA-ADP","ssvc":{"Exploitation":"none","Automatable":"yes","Technical Impact":"partial"}}],"affected":[{"vendor":"F5","product":"NGINX Plus","defaultStatus":"unknown","modules":["ngx_stream_mqtt_filter_module"],"versions":["affected R30 <* (custom) changes:unaffected@R31 P3;unaffected@R32 P1"]},{"vendor":"f5","product":"nginx_plus","defaultStatus":"unknown","cpes":["cpe:2.3:a:f5:nginx_plus:r30:-:*:*:*:*:*:*"],"versions":["affected r30 <r32_p1 (custom)","affected r30 <r31_p3 (custom)"]}],"references":[{"url":"https://my.f5.com/manage/s/article/K000140108","tags":["vendor-advisory"]}],"credits":["F5"],"vendors":["nginx"]}
