{"id":"CVE-2013-0337","state":"PUBLISHED","assigner":"redhat","published":"2013-10-27T00:00:00.000Z","updated":"2024-08-06T14:25:09.144Z","description":"The default configuration of nginx, possibly 1.3.13 and earlier, uses world-readable permissions for the (1) access.log and (2) error.log files, which allows local users to obtain sensitive information by reading the files.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://secunia.com/advisories/55181","tags":["third-party-advisory","x_refsource_SECUNIA"],"name":"55181"},{"url":"http://www.openwall.com/lists/oss-security/2013/02/24/1","tags":["mailing-list","x_refsource_MLIST"],"name":"[oss-security] 20130224 nginx CVE-2013-0337 world-readable logs"},{"url":"http://www.openwall.com/lists/oss-security/2013/02/22/1","tags":["mailing-list","x_refsource_MLIST"],"name":"[oss-security] 20130221 Re: CVE request: nginx world-readable logdir"},{"url":"http://security.gentoo.org/glsa/glsa-201310-04.xml","tags":["vendor-advisory","x_refsource_GENTOO"],"name":"GLSA-201310-04"},{"url":"http://www.openwall.com/lists/oss-security/2013/02/21/15","tags":["mailing-list","x_refsource_MLIST"],"name":"[oss-security] 20130221 nginx world-readable logdir"}],"vendors":["nginx"]}
