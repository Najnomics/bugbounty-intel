{"id":"CVE-2023-1550","state":"PUBLISHED","assigner":"f5","published":"2023-03-29T16:34:38.119Z","updated":"2025-02-13T16:39:29.086Z","title":"NGINX Agent vulnerability CVE-2023-1550","description":"Insertion of Sensitive Information into log file vulnerability in NGINX Agent. NGINX Agent version 2.0 before 2.23.3 inserts sensitive information into a log file. An authenticated attacker with local access to read agent log files may gain access to private keys. This issue is only exposed when the non-default trace level logging is enabled. Note: NGINX Agent is included with NGINX Instance Manager and used in conjunction with NGINX API Connectivity Manager, and NGINX Management Suite Security Monitoring.","cwe":["CWE-532 CWE-532 Insertion of Sensitive Information into Log File"],"metrics":[{"src":"cna","v":"3.1","score":5.5,"sev":"MEDIUM","vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N"},{"src":"CISA-ADP","ssvc":{"Exploitation":"none","Automatable":"no","Technical Impact":"partial"}}],"affected":[{"vendor":"F5","product":"NGINX Agent","repo":"https://github.com/nginx/agent/","defaultStatus":"unknown","versions":["affected 2.0 <2.23.3 (semver)"]}],"references":[{"url":"https://my.f5.com/manage/s/article/K000133135"},{"url":"https://security.netapp.com/advisory/ntap-20230511-0008/"}],"configurations":["Non-default trace level logging enabled."],"vendors":["nginx"]}
