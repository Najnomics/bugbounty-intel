{"id":"CVE-2008-0985","state":"PUBLISHED","assigner":"mitre","published":"2008-03-06T00:00:00.000Z","updated":"2024-08-07T08:01:40.199Z","description":"Heap-based buffer overflow in the GIF library in the WebKit framework for Google Android SDK m3-rc37a and earlier allows remote attackers to execute arbitrary code via a crafted GIF file whose logical screen height and width are different than the actual height and width.","cwe":["n/a"],"metrics":[],"affected":[{"vendor":"n/a","product":"n/a","versions":["affected n/a"]}],"references":[{"url":"http://securityreason.com/securityalert/3727","tags":["third-party-advisory","x_refsource_SREASON"],"name":"3727"},{"url":"https://exchange.xforce.ibmcloud.com/vulnerabilities/40998","tags":["vdb-entry","x_refsource_XF"],"name":"androidsdk-gifimagedecoderondecode-bo(40998)"},{"url":"http://www.coresecurity.com/?action=item&id=2148","tags":["x_refsource_MISC"]},{"url":"http://android-developers.blogspot.com/2008/03/android-sdk-update-m5-rc15-released.html","tags":["x_refsource_CONFIRM"]},{"url":"http://www.securityfocus.com/bid/28005","tags":["vdb-entry","x_refsource_BID"],"name":"28005"},{"url":"http://www.securityfocus.com/archive/1/489135/100/0/threaded","tags":["mailing-list","x_refsource_BUGTRAQ"],"name":"20080304 CORE-2008-0124: Multiple vulnerabilities in Google's Android SDK"}],"exploitdb":[{"edb":"31307","title":"Google Android Web Browser - '.GIF' File Heap Buffer Overflow","type":"dos","platform":"android","date":"2008-03-04","verified":"1"}],"vendors":["android"]}
